@page "/achievements"
@implements IDisposable
@inject ReferenceService Reference
@inject RecordsService RecordsData
@inject AchievementsService AchievementsData
@inject AppState State
@inject NavigationManager Nav

@if (_loading)
{
    <LoadingSkeleton />
}
else
{
    <div class="space-y-10">
        <div>
            <h2 class="text-2xl font-semibold text-zinc-900 dark:text-white">Achievements</h2>
            <p class="mt-1 text-zinc-600 dark:text-zinc-400">Athletic records and sports achievements for the recreation center.</p>
        </div>

        @if (_loadError is not null)
        {
            <p role="alert" class="@Ui.ErrorBanner">@_loadError</p>
        }

        <section>
            <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
                <h3 class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">Athletic Records</h3>
                <div class="flex flex-wrap gap-2">
                    <TracksManager Tracks="_tracks" OnChanged="ReloadAsync" />
                    <CsvImportDialog Type="ImportType.Records" />
                </div>
            </div>
            <RecordsSection Records="_records" Tracks="_tracks" Years="_years" SelectedYear="_selectedYear"
                            OnYearSelected="SelectYear" OnChanged="ReloadAsync" />
        </section>

        <section>
            <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
                <h3 class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">Sports Achievements</h3>
                <CsvImportDialog Type="ImportType.Achievements" />
            </div>
            <AchievementsSection Achievements="_achievements" Houses="_houses" Years="_years" SelectedYear="_selectedYear"
                                 OnYearSelected="SelectYear" OnChanged="ReloadAsync" />
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private string? _loadError;
    private string? _loadedQuery;
    private int _selectedYear;
    private List<int> _years = new();
    private List<SportTrack> _tracks = new();
    private List<SportRecord> _records = new();
    private List<House> _houses = new();
    private List<SportsAchievement> _achievements = new();

    protected override void OnInitialized()
    {
        State.RefreshRequested += ReloadAsync;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override Task OnParametersSetAsync() => ApplyLocationAsync();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!Nav.ToBaseRelativePath(e.Location).StartsWith("achievements", StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await ApplyLocationAsync();
            StateHasChanged();
        });
    }

    private async Task ApplyLocationAsync()
    {
        var query = new Uri(Nav.Uri).Query;
        if (query == _loadedQuery) return;
        var firstLoad = _loadedQuery is null;
        _loadedQuery = query;

        var defaultYear = DateTime.Now.Year;
        var raw = System.Web.HttpUtility.ParseQueryString(query)["year"] ?? defaultYear.ToString(CultureInfo.InvariantCulture);
        var parsed = Formatting.ParseIntLoose(raw);
        _selectedYear = parsed is null or 0 ? defaultYear : parsed.Value;
        _years = new[] { _selectedYear, _selectedYear - 1, _selectedYear - 2, defaultYear }
            .Distinct()
            .OrderByDescending(y => y)
            .ToList();

        if (firstLoad) _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            var tracks = Reference.GetSportTracksAsync();
            var records = RecordsData.GetForYearAsync(_selectedYear);
            var houses = Reference.GetHousesAsync();
            var achievements = AchievementsData.GetForYearAsync(_selectedYear);
            await Task.WhenAll(tracks, records, houses, achievements);
            _tracks = tracks.Result;
            _records = records.Result;
            _houses = houses.Result;
            _achievements = achievements.Result;
            _loadError = null;
        }
        catch (Exception ex) when (ex is PostgrestException or HttpRequestException or TaskCanceledException)
        {
            _loadError = ex.Message;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectYear(int year) => Nav.NavigateTo($"/achievements?year={year}");

    public void Dispose()
    {
        State.RefreshRequested -= ReloadAsync;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
