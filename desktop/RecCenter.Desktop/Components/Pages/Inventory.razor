@page "/inventory"
@implements IDisposable
@inject InventoryService InventoryData
@inject AppState State
@inject AuthService Auth

@if (_items is null && _loadError is null)
{
    <LoadingSkeleton />
}
else
{
    <div class="space-y-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold text-zinc-900 dark:text-white">Inventory</h2>
                <p class="mt-1 text-zinc-600 dark:text-zinc-400">Track equipment quantities. Add new items or edit existing counts.</p>
            </div>
        </div>
        <nav aria-label="Inventory phases" class="flex w-fit flex-wrap items-center gap-1 rounded-full border border-zinc-200 bg-zinc-50 p-1 dark:border-white/10 dark:bg-white/5">
            @foreach (var phase in Phases)
            {
                var active = _phase == phase.Id;
                <button type="button" aria-current="@(active ? "page" : null)" @onclick="() => _phase = phase.Id"
                        class="@Ui.Cn("rounded-full px-4 py-1.5 text-sm font-medium transition",
                            active ? "bg-emerald-500 text-zinc-950 shadow-sm dark:bg-emerald-400" : "text-zinc-600 hover:bg-white hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-white/10 dark:hover:text-white")">
                    @phase.Label
                </button>
            }
        </nav>
        <nav aria-label="Inventory categories" class="inline-flex flex-wrap items-center gap-1 border-b border-zinc-200 dark:border-white/10">
            @foreach (var category in Categories)
            {
                var active = _category == category.Id;
                <button type="button" aria-current="@(active ? "page" : null)" @onclick="() => _category = category.Id"
                        class="@Ui.Cn("-mb-px border-b-2 px-3 py-2 text-sm font-medium transition",
                            active ? "border-emerald-500 text-zinc-900 dark:border-emerald-400 dark:text-white" : "border-transparent text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white")">
                    @category.Label
                </button>
            }
        </nav>

        @if (_loadError is not null)
        {
            <p role="alert" class="@Ui.ErrorBanner">@_loadError</p>
        }

        <div class="space-y-6">
            @if (Auth.CanEdit)
            {
            <div class="flex justify-end">
                <Button OnClick="ToggleAdd">@(_showAdd ? "Cancel" : "Add item")</Button>
            </div>
            }

            @if (_error is not null)
            {
                <p role="alert" class="@Ui.ErrorBanner">@_error</p>
            }

            @if (Auth.CanEdit && _showAdd)
            {
                <Card>
                    <h3 class="font-medium text-zinc-900 dark:text-white">New inventory item</h3>
                    <form @onsubmit="HandleAdd" class="mt-4 flex flex-wrap items-end gap-4">
                        <div class="min-w-[200px] flex-1">
                            <label for="name" class="@Ui.Label">Item name</label>
                            <input id="name" class="@Ui.Input" placeholder="Basketballs" required @bind="_addForm.Name" />
                        </div>
                        <div class="w-32">
                            <label for="quantity" class="@Ui.Label">Quantity</label>
                            <input id="quantity" class="@Ui.Input" type="number" min="0" required @bind="_addForm.Quantity" />
                        </div>
                        <Button Type="submit" Disabled="_pending">@(_pending ? "Saving…" : "Add")</Button>
                    </form>
                    @if (_error is not null)
                    {
                        <p class="mt-2 text-sm text-red-600 dark:text-red-300">@_error</p>
                    }
                </Card>
            }

            <Card Class="overflow-hidden p-0">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="@Ui.TableHead">
                            <tr>
                                <th class="@Ui.Th">Item</th>
                                <th class="@Ui.Th">Quantity</th>
                                <th class="@Ui.Th">Last updated</th>
                                @if (Auth.CanEdit)
                                {
                                <th class="@Ui.Th">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Visible.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="px-4 py-8 text-center text-zinc-500 dark:text-zinc-400">No items in this list yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Visible)
                                {
                                    <tr @key="item.Id" class="border-b border-zinc-100 last:border-0 dark:border-white/10">
                                        @if (Auth.CanEdit && _editingId == item.Id && _editForm is not null)
                                        {
                                            <td colspan="4" class="px-4 py-3">
                                                <form @onsubmit="HandleUpdate" class="flex flex-wrap items-end gap-3">
                                                    <div class="min-w-[180px] flex-1">
                                                        <label class="@Ui.Label">Name</label>
                                                        <input class="@Ui.Input" required @bind="_editForm.Name" />
                                                    </div>
                                                    <div class="w-28">
                                                        <label class="@Ui.Label">Qty</label>
                                                        <input class="@Ui.Input" type="number" min="0" required @bind="_editForm.Quantity" />
                                                    </div>
                                                    <Button Type="submit" Disabled="_pending">Save</Button>
                                                    <Button Variant="secondary" OnClick="() => _editingId = null">Cancel</Button>
                                                </form>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="px-4 py-3 font-medium text-zinc-900 dark:text-white">@item.Name</td>
                                            <td class="px-4 py-3">@item.Quantity</td>
                                            <td class="px-4 py-3 text-zinc-500 dark:text-zinc-400">@Ui.FormatDateTime(item.UpdatedAt)</td>
                                            @if (Auth.CanEdit)
                                            {
                                            <td class="px-4 py-3">
                                                <div class="flex flex-wrap gap-2">
                                                    <Button Variant="ghost" OnClick="() => StartEdit(item)">Edit</Button>
                                                    <Button Variant="danger" OnClick="() => HandleDelete(item.Id, item.Name)" Disabled="_pending">Delete</Button>
                                                </div>
                                            </td>
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </Card>
        </div>
        @if (_askOpen)
        {
            <ConfirmDialog Title="@_askTitle" Description="@_askBody" Pending="_pending" OnConfirm="() => Answer(true)" OnClose="() => Answer(false)" />
        }
    </div>
}

@code {
    private List<InventoryItem>? _items;
    private string? _loadError;
    private bool _showAdd;
    private InventoryForm _addForm = new();
    private string? _editingId;
    private InventoryForm? _editForm;
    private string? _error;
    private bool _pending;
    private string _phase = "phase_01";
    private string _category = "rec";
    private bool _askOpen;
    private string _askTitle = "";
    private string _askBody = "";
    private TaskCompletionSource<bool>? _answer;

    private static readonly (string Id, string Label)[] Phases = { ("phase_01", "Phase 01"), ("phase_02", "Phase 02") };
    private static readonly (string Id, string Label)[] Categories = { ("rec", "Rec Inventory"), ("gym", "Gym Inventory") };

    private List<InventoryItem> Visible =>
        (_items ?? new()).Where(item => item.Phase == _phase && item.Category == _category).ToList();

    private Task<bool> AskAsync(string title, string body)
    {
        _askTitle = title;
        _askBody = body;
        _askOpen = true;
        _answer = new TaskCompletionSource<bool>();
        _ = InvokeAsync(StateHasChanged);
        return _answer.Task;
    }

    private void Answer(bool yes)
    {
        _askOpen = false;
        _answer?.TrySetResult(yes);
    }

    protected override async Task OnInitializedAsync()
    {
        State.RefreshRequested += ReloadAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await InventoryData.GetAllAsync();
            _loadError = null;
        }
        catch (Exception ex) when (ex is PostgrestException or HttpRequestException or TaskCanceledException)
        {
            _items ??= new();
            _loadError = ex.Message;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleAdd()
    {
        _showAdd = !_showAdd;
        if (_showAdd) _addForm = new InventoryForm { Phase = _phase, Category = _category };
    }

    private void StartEdit(InventoryItem item)
    {
        _editingId = item.Id;
        _editForm = new InventoryForm
        {
            Id = item.Id,
            Name = item.Name,
            Quantity = item.Quantity.ToString(CultureInfo.InvariantCulture),
            Phase = item.Phase,
            Category = item.Category,
        };
    }

    private async Task HandleAdd()
    {
        _error = null;
        _pending = true;
        _addForm.Phase = _phase;
        _addForm.Category = _category;
        var result = await InventoryData.AddAsync(_addForm);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _showAdd = false;
        _addForm = new InventoryForm();
        await LoadAsync();
    }

    private async Task HandleUpdate()
    {
        if (_editForm is null) return;
        _error = null;
        _pending = true;
        var result = await InventoryData.UpdateAsync(_editForm);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _editingId = null;
        await LoadAsync();
    }

    private async Task HandleDelete(string id, string name)
    {
        if (!await AskAsync($"Delete \"{name}\"?", "This removes the item from the current inventory list.")) return;
        _error = null;
        _pending = true;
        var result = await InventoryData.DeleteAsync(id);
        _pending = false;
        if (!result.Success) _error = result.Error;
        else
        {
            if (_editingId == id) _editingId = null;
            await LoadAsync();
        }
    }

    public void Dispose() => State.RefreshRequested -= ReloadAsync;
}
