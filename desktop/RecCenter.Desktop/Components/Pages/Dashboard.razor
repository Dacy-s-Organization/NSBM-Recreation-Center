@page "/"
@implements IDisposable
@inject DashboardService DashboardData
@inject AppState State
@inject AuthService Auth

@if (_stats is null && _error is null)
{
    <LoadingSkeleton />
}
else
{
    <div class="space-y-8">
        <div>
            <h2 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-white">Dashboard</h2>
            <p class="mt-2 text-zinc-600 dark:text-zinc-400">University recreation center overview</p>
        </div>

        @if (_error is not null)
        {
            <p role="alert" class="@Ui.ErrorBanner">@_error</p>
        }

        <div class="grid gap-4 sm:grid-cols-3">
            @foreach (var stat in Stats)
            {
                <a href="@stat.Href">
                    <Card Class="relative overflow-hidden transition hover:border-emerald-400/60 hover:shadow-md dark:hover:border-emerald-400/40">
                        <span aria-hidden="true" class="@($"absolute inset-x-0 top-0 h-1 {stat.Accent}")"></span>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400">@stat.Label</p>
                        <p class="mt-2 text-3xl font-semibold text-zinc-900 dark:text-white">@stat.Value</p>
                    </Card>
                </a>
            }
        </div>

        @if (Auth.CanEdit)
        {
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 class="font-medium text-zinc-900 dark:text-white">Staff accounts</h3>
                    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                        Add a read-only account or another super account. No verification email is sent.
                    </p>
                </div>
                <Button OnClick="OpenAddUser">Add user</Button>
            </div>
            @if (_userMessage is not null)
            {
                <p class="text-sm text-emerald-800 dark:text-emerald-300">@_userMessage</p>
            }
        }

        <div class="grid gap-4 sm:grid-cols-2">
            @foreach (var link in QuickLinks)
            {
                <a href="@link.Href">
                    <Card Class="transition hover:border-emerald-400/60 dark:hover:border-emerald-400/40">
                        <h3 class="font-medium text-zinc-900 dark:text-white">@link.Title</h3>
                        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">@link.Desc</p>
                    </Card>
                </a>
            }
        </div>
    </div>

    @if (_addUserOpen)
    {
        <Modal TrapKeyboard="true" CloseOnBackdrop="true" OnClose="CloseAddUser" PanelClass="w-full max-w-md p-6">
            <h3 class="font-medium text-zinc-900 dark:text-white">Add user</h3>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                Set the email, password, and role. The person can sign in immediately. No verification email is sent.
            </p>
            <form @onsubmit="CreateUser" class="mt-4 space-y-4">
                <div>
                    <label for="staff-email" class="@Ui.Label">Email</label>
                    <input id="staff-email" class="@Ui.Input" type="email" required autocomplete="off" @bind="_staffEmail" />
                </div>
                <div>
                    <label for="staff-role" class="@Ui.Label">Role</label>
                    <select id="staff-role" class="@Ui.Input" @bind="_staffRole">
                        <option value="mic">Read-only</option>
                        <option value="super">Super</option>
                    </select>
                </div>
                <div>
                    <label for="staff-password" class="@Ui.Label">Password</label>
                    <input id="staff-password" class="@Ui.Input" type="password" required minlength="12" autocomplete="new-password" @bind="_staffPassword" />
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">At least 12 characters, with an uppercase letter, a lowercase letter, and a number.</p>
                </div>
                @if (_userError is not null)
                {
                    <p class="text-sm text-red-600 dark:text-red-300">@_userError</p>
                }
                <div class="flex justify-end gap-2">
                    <Button Variant="secondary" OnClick="CloseAddUser" Disabled="_creatingUser">Cancel</Button>
                    <Button Type="submit" Disabled="_creatingUser">@(_creatingUser ? "Saving…" : "Create account")</Button>
                </div>
            </form>
        </Modal>
    }
}

@code {
    private DashboardStats? _stats;
    private string? _error;
    private bool _addUserOpen;
    private bool _creatingUser;
    private string _staffEmail = "";
    private string _staffPassword = "";
    private string _staffRole = "mic";
    private string? _userError;
    private string? _userMessage;

    private static readonly (string Href, string Title, string Desc)[] QuickLinks =
    {
        ("/students", "Manage students", "Search by ID and assign houses"),
        ("/achievements", "Achievements", "Athletic records and sports achievements"),
        ("/inventory", "Equipment inventory", "Track quantities of gear"),
    };

    private IEnumerable<(string Label, int Value, string Href, string Accent)> Stats
    {
        get
        {
            var s = _stats ?? new DashboardStats(0, 0, 0, DateTime.Now.Year);
            yield return ("Students", s.Students, "/students", "bg-emerald-600 dark:bg-emerald-400");
            yield return ($"Records ({s.Year})", s.Records, "/achievements", "bg-brand-navy");
            yield return ("Inventory items", s.InventoryItems, "/inventory", "bg-brand-cyan");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.RefreshRequested += LoadAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _stats = await DashboardData.GetStatsAsync();
            _error = null;
        }
        catch (PostgrestException ex)
        {
            _error = ex.Message == ConnectionState.SessionMessage ? null : ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OpenAddUser()
    {
        _userError = null;
        _addUserOpen = true;
    }

    private void CloseAddUser()
    {
        if (_creatingUser) return;
        _addUserOpen = false;
        _userError = null;
    }

    private async Task CreateUser()
    {
        _creatingUser = true;
        _userError = null;
        _userMessage = null;
        var error = await Auth.CreateStaffUserAsync(_staffEmail, _staffPassword, _staffRole);
        _creatingUser = false;
        if (error is not null)
        {
            _userError = error;
            return;
        }
        _userMessage = $"{_staffEmail.Trim()} can sign in with the password you set. No verification email was sent.";
        _staffEmail = "";
        _staffPassword = "";
        _staffRole = "mic";
        _addUserOpen = false;
    }

    public void Dispose() => State.RefreshRequested -= LoadAsync;
}
