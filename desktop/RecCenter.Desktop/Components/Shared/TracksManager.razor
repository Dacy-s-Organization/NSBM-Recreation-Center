@inject TracksService TracksData
@inject AuthService Auth

@if (Auth.CanEdit)
{
<Button Variant="secondary" OnClick="() => _open = !_open">@(_open ? "Close tracks" : "Manage tracks")</Button>

@if (_open)
{
    <Card Class="mt-4">
        <h4 class="font-medium text-zinc-900 dark:text-white">Sport tracks</h4>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
            Add events for athletic records (e.g. 100m Run, Long Jump). Use seconds
            (s) for timed runs and meters (m) for jumps and throws.
        </p>

        <form @onsubmit="HandleAdd" class="mt-4 grid gap-4 sm:grid-cols-3 sm:items-end">
            <div>
                <label for="track-name" class="@Ui.Label">Track name</label>
                <input id="track-name" class="@Ui.Input" required placeholder="e.g. 800m Run" @bind="_form.Name" />
            </div>
            <div>
                <label for="track-unit" class="@Ui.Label">Unit</label>
                <select id="track-unit" class="@Ui.Select" required @bind="_form.Unit">
                    <option value="s">Seconds (s) — runs</option>
                    <option value="m">Meters (m) — jumps / throws</option>
                </select>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
                    <input type="checkbox" class="rounded border-zinc-300 dark:border-white/20" @bind="_form.LowerIsBetter" />
                    Lower is better (faster times)
                </label>
                <Button Type="submit" Disabled="_pending">@(_pending ? "Adding…" : "Add track")</Button>
            </div>
        </form>

        @if (_error is not null)
        {
            <p class="mt-2 text-sm text-red-600 dark:text-red-300">@_error</p>
        }

        <div class="mt-6 overflow-x-auto rounded-lg border border-zinc-200 dark:border-white/10">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-zinc-100 bg-zinc-50 dark:border-white/10 dark:bg-white/5">
                    <tr>
                        <th class="px-3 py-2 font-medium text-zinc-600 dark:text-zinc-400">Track</th>
                        <th class="px-3 py-2 font-medium text-zinc-600 dark:text-zinc-400">Unit</th>
                        <th class="px-3 py-2 font-medium text-zinc-600 dark:text-zinc-400">Lower is better</th>
                        <th class="px-3 py-2 font-medium text-zinc-600 dark:text-zinc-400">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Tracks.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-3 py-4 text-zinc-500 dark:text-zinc-400">No tracks yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Tracks)
                        {
                            <tr @key="t.Id" class="border-b border-zinc-50 last:border-0 dark:border-white/10">
                                <td class="px-3 py-2 font-medium text-zinc-900 dark:text-white">@t.Name</td>
                                <td class="px-3 py-2 text-zinc-700 dark:text-zinc-300">@Formatting.TrackUnitLabel(t.Unit) (@t.Unit)</td>
                                <td class="px-3 py-2 text-zinc-700 dark:text-zinc-300">@(t.LowerIsBetter ? "Yes" : "No")</td>
                                <td class="px-3 py-2">
                                    <Button Variant="danger" OnClick="() => HandleDelete(t)" Disabled="_pending">Delete</Button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </Card>
    @if (_askOpen)
    {
        <ConfirmDialog Title="@_askTitle" Description="@_askBody" Pending="_pending" OnConfirm="() => Answer(true)" OnClose="() => Answer(false)" />
    }
}
}

@code {
    [Parameter] public IReadOnlyList<SportTrack> Tracks { get; set; } = Array.Empty<SportTrack>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _open;
    private bool _pending;
    private bool _askOpen;
    private string _askTitle = "";
    private string _askBody = "";
    private TaskCompletionSource<bool>? _answer;

    private Task<bool> AskAsync(string title, string body)
    {
        _askTitle = title;
        _askBody = body;
        _askOpen = true;
        _answer = new TaskCompletionSource<bool>();
        _ = InvokeAsync(StateHasChanged);
        return _answer.Task;
    }

    private void Answer(bool yes)
    {
        _askOpen = false;
        _answer?.TrySetResult(yes);
    }
    private string? _error;
    private TrackForm _form = new();

    private async Task HandleAdd()
    {
        _error = null;
        _pending = true;
        var result = await TracksData.AddAsync(_form);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _open = false;
        _form = new TrackForm();
        await OnChanged.InvokeAsync();
    }

    private async Task HandleDelete(SportTrack track)
    {
        if (!await AskAsync($"Delete track \"{track.Name}\"?", "Records that use this track are kept, but the track cannot be deleted while a record still points at it.")) return;
        _error = null;
        _pending = true;
        var result = await TracksData.DeleteAsync(track.Id);
        _pending = false;
        if (!result.Success) _error = result.Error;
        else await OnChanged.InvokeAsync();
    }
}
