<form @onsubmit="Submit" class="grid gap-4 sm:grid-cols-2">
    @if (HasCategories)
    {
        <div>
            <label class="@Ui.Label">Category</label>
            <select class="@Ui.Select" @bind="_form.Category" @bind:after="OnCategoryChanged">
                <option value="other">Other sports</option>
                <option value="athletics">Athletics</option>
            </select>
        </div>
    }
    @if (_form.Category == "athletics")
    {
        <div>
            <label class="@Ui.Label">Event</label>
            <select class="@Ui.Select" required @bind="_form.TrackId">
                <option value="" disabled>Select event</option>
                @foreach (var track in Tracks)
                {
                    <option value="@track.Id">@track.Name</option>
                }
            </select>
        </div>
    }
    else
    {
    <div>
        <label class="@Ui.Label">Sport</label>
        <select class="@Ui.Select" required @bind="_sportChoice">
            <option value="" disabled>Select sport</option>
            @foreach (var name in SportOptions)
            {
                <option value="@name">@name</option>
            }
            <option value="@AchievementTypes.NewSport">Add a new sport</option>
        </select>
    </div>
    @if (_sportChoice == AchievementTypes.NewSport)
    {
        <div class="sm:col-span-2">
            <label class="@Ui.Label">New sport</label>
            <input class="@Ui.Input" required placeholder="Name of the new sport" @bind="_form.NewSport" />
            <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">This name is saved and appears in the sport menu after you save the achievement.</p>
        </div>
    }
    }
    <div>
        <label class="@Ui.Label">Achievement type</label>
        <select class="@Ui.Select" required @bind="_form.AchievementType">
            <option value="" disabled>Select type</option>
            @foreach (var t in AchievementTypes.ForCategory(HasCategories ? _form.Category : "other"))
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div>
        <label class="@Ui.Label">Year</label>
        <input class="@Ui.Input" type="number" required @bind="_form.MeetYear" />
    </div>
    <div>
        <label class="@Ui.Label">House (team)</label>
        <select class="@Ui.Select" @bind="_form.TeamName">
            <option value="">No house</option>
            @foreach (var h in Houses)
            {
                <option value="@h.Name">@h.Name</option>
            }
        </select>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Optional. Leave blank when the result is not for a house.</p>
    </div>
    <div>
        <label class="@Ui.Label">Team card</label>
        <select class="@Ui.Select" @bind="_form.TeamCardId">
            <option value="">No team card</option>
            @foreach (var card in TeamCards)
            {
                <option value="@card.Id">@card.EventName</option>
            }
        </select>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Only team cards already saved in this section are listed.</p>
    </div>
    @if (_form.AchievementType == AchievementTypes.Champion)
    {
        <div class="sm:col-span-2 space-y-3">
            <label class="@Ui.Label">Places</label>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">Name and NIC come from the student record. Several students can share the same place.</p>
            @for (var i = 0; i < _places.Count; i++)
            {
                var index = i;
                <div class="grid gap-2 sm:grid-cols-[8rem_1fr_auto]">
                    <select class="@Ui.Select" @bind="_places[index].Place">
                        <option value="1st">1st</option>
                        <option value="2nd">2nd</option>
                        <option value="3rd">3rd</option>
                    </select>
                    <div>
                        <input class="@Ui.Input" placeholder="Student ID" @bind="_places[index].StudentId" @bind:event="oninput" @bind:after="() => LookupPlace(index)" />
                        @if (_hints.TryGetValue(index, out var hint))
                        {
                            <p class="mt-1 text-xs @(hint == "Student not found" ? "text-red-600" : "text-emerald-700 dark:text-emerald-400")">@hint</p>
                        }
                    </div>
                    <Button Variant="ghost" OnClick="() => RemovePlace(index)">Remove</Button>
                </div>
            }
            <Button Variant="secondary" OnClick="AddPlace">Add place</Button>
        </div>
    }
    else
    {
        <div class="sm:col-span-2">
            <label class="@Ui.Label">@(_form.AchievementType == AchievementTypes.BestPlayer ? "Best Player student ID" : "Student ID (optional)")</label>
            <input class="@Ui.Input" required="@(_form.AchievementType == AchievementTypes.BestPlayer)" placeholder="e.g. 2024001" @bind="_form.WinnerStudentId" />
            <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                @(_form.AchievementType == AchievementTypes.BestPlayer
                    ? "Enter one student ID for this house's Best Player award."
                    : "Enter a student ID for a personal achievement. Leave blank for a team result.")
            </p>
        </div>
    }
    <div class="sm:col-span-2">
        <label class="@Ui.Label">Notes (optional)</label>
        <input class="@Ui.Input" placeholder="Any extra info" @bind="_form.Notes" />
    </div>
    <div class="sm:col-span-2">
        <label class="@Ui.Label">Reference no</label>
        <input class="@Ui.Input" placeholder="AA00001" @bind="_form.ReferenceNo" />
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Leave blank and the next AA number is assigned. Type one only when the certificate was already issued.</p>
    </div>
    <div class="sm:col-span-2">
        <label class="@Ui.Label">Certificates</label>
        <FilePicker OnChange="OnCertificateFiles" FileNames="@_form.Uploads.Select(u => u.FileName).ToList()" />
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Jpeg, png, webp, gif, or heif. Each file must be 4 MB or smaller.</p>
        @if (Achievement?.CertificateReferences?.IssuedCertificates is { Count: > 0 } existing)
        {
            <div class="mt-2 space-y-1">
                <p class="text-sm text-zinc-600 dark:text-zinc-300">Remove on save</p>
                @foreach (var file in existing)
                {
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" checked="@_form.RemoveCertificateIds.Contains(file.Id)" @onchange="e => ToggleRemove(file.Id, e)" />
                        @file.FileName
                    </label>
                }
            </div>
        }
    </div>
    <div class="flex flex-wrap gap-2 sm:col-span-2">
        <Button Type="submit" Disabled="Pending">@(Pending ? "Saving…" : SubmitLabel)</Button>
        @if (OnCancel.HasDelegate)
        {
            <Button Variant="secondary" OnClick="OnCancel">Cancel</Button>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="w-full text-sm text-red-600 dark:text-red-300">@Error</p>
        }
    </div>
</form>

@code {
    [Inject] private AchievementsService AchievementsData { get; set; } = default!;
    [Inject] private RecordsService RecordsData { get; set; } = default!;

    [Parameter] public SportsAchievement? Achievement { get; set; }
    [Parameter] public IReadOnlyList<House> Houses { get; set; } = Array.Empty<House>();
    [Parameter] public int DefaultYear { get; set; }
    [Parameter] public bool Pending { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Save";
    [Parameter] public EventCallback<AchievementForm> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool HasCategories { get; set; }
    [Parameter] public string? DefaultCategory { get; set; }
    [Parameter] public IReadOnlyList<SportTrack> Tracks { get; set; } = Array.Empty<SportTrack>();
    [Parameter] public IReadOnlyList<TeamCardOption> TeamCards { get; set; } = Array.Empty<TeamCardOption>();

    private AchievementForm _form = new();
    private string _sportChoice = "";
    private List<Sport> _sports = new();
    private List<PlaceEntry> _places = new() { new() };
    private readonly Dictionary<int, string> _hints = new();
    private readonly Dictionary<int, CancellationTokenSource> _lookups = new();

    private IEnumerable<string> SportOptions
    {
        get
        {
            var names = _sports.Select(s => s.Name).ToList();
            var current = Achievement?.Sport;
            if (!string.IsNullOrEmpty(current) && !names.Any(name => string.Equals(name, current, StringComparison.OrdinalIgnoreCase)))
                names.Add(current);
            return names;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var a = Achievement;
        _sportChoice = a?.Sport ?? "";
        _form = new AchievementForm
        {
            Id = a?.Id ?? "",
            Category = (a?.Category ?? DefaultCategory) == "athletics" ? "athletics" : "other",
            TrackId = a?.TrackId ?? "",
            Sport = _sportChoice,
            AchievementType = a?.AchievementType ?? "",
            MeetYear = (a?.MeetYear ?? DefaultYear).ToString(CultureInfo.InvariantCulture),
            TeamName = HouseNameFor(a),
            TeamCardId = a?.TeamCardId ?? "",
            WinnerStudentId = a?.AchievementType == AchievementTypes.Champion
                ? ""
                : a?.SportsAchievementWinners?.FirstOrDefault()?.Students?.StudentId ?? "",
            Notes = a?.Notes ?? "",
            ReferenceNo = a?.CertificateReferences?.ReferenceNo ?? "",
        };
        if (a?.AchievementType == AchievementTypes.Champion && a.SportsAchievementWinners is { Count: > 0 })
        {
            _places = a.SportsAchievementWinners.Select(w => new PlaceEntry
            {
                Place = w.Place is "1st" or "2nd" or "3rd" ? w.Place : "1st",
                StudentId = w.Students?.StudentId ?? "",
            }).ToList();
        }
        try
        {
            _sports = await AchievementsData.ListSportsAsync();
        }
        catch (PostgrestException)
        {
            _sports = new List<Sport>();
        }
    }

    private string HouseNameFor(SportsAchievement? a)
    {
        if (string.IsNullOrEmpty(a?.TeamName)) return "";
        return Houses.FirstOrDefault(h => h.Name == a.TeamName)?.Name ?? a.TeamName;
    }

    private void AddPlace() => _places.Add(new PlaceEntry());

    private void RemovePlace(int index)
    {
        if (index >= 0 && index < _places.Count) _places.RemoveAt(index);
        _hints.Clear();
    }

    private void ToggleRemove(string id, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on)
        {
            if (!_form.RemoveCertificateIds.Contains(id)) _form.RemoveCertificateIds.Add(id);
        }
        else _form.RemoveCertificateIds.Remove(id);
    }

    private async Task OnCertificateFiles(InputFileChangeEventArgs e)
    {
        _form.Uploads.Clear();
        foreach (var file in e.GetMultipleFiles(8))
        {
            if (file.Size > CertificateService.MaxBytes) return;
            await using var stream = file.OpenReadStream(CertificateService.MaxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _form.Uploads.Add(new CertificateUpload
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Bytes = memory.ToArray(),
            });
        }
    }

    private void LookupPlace(int index)
    {
        if (_lookups.Remove(index, out var previous))
        {
            previous.Cancel();
            previous.Dispose();
        }
        var cts = new CancellationTokenSource();
        _lookups[index] = cts;
        _ = RunPlaceLookup(index, cts.Token);
    }

    private async Task RunPlaceLookup(int index, CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (index >= _places.Count) return;
            var studentId = _places[index].StudentId;
            if (studentId.Trim().Length == 0)
            {
                _hints.Remove(index);
                await InvokeAsync(StateHasChanged);
                return;
            }
            var result = await RecordsData.LookupStudentAsync(studentId);
            if (token.IsCancellationRequested) return;
            _hints[index] = result is null
                ? "Student not found"
                : $"{result.FullName}{(string.IsNullOrWhiteSpace(result.Nic) ? " · NIC not stored" : $" · NIC {result.Nic}")}";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception ex) when (ex is PostgrestException or HttpRequestException)
        {
            _hints[index] = "Student not found";
        }
    }

    private void OnCategoryChanged()
    {
        if (!AchievementTypes.ForCategory(_form.Category).Contains(_form.AchievementType))
            _form.AchievementType = "";
    }

    private Task Submit()
    {
        if (_form.Category != "athletics") _form.Sport = _sportChoice;
        _form.Places = _places;
        return OnSubmit.InvokeAsync(_form);
    }
}
