<div class="flex flex-wrap items-center gap-3">
    <label class="@Ui.Cn(Ui.ButtonBase, Ui.ButtonSecondary, Disabled ? "pointer-events-none opacity-50" : "cursor-pointer")" aria-disabled="@(Disabled ? "true" : null)">
        @ButtonText
        <InputFile class="hidden" multiple="@Multiple" accept="@Accept" disabled="@Disabled" OnChange="OnChange" />
    </label>
    @if (ShowSummary)
    {
        <span class="min-w-0 break-words text-sm text-zinc-600 dark:text-zinc-400">@SummaryText</span>
    }
</div>

@code {
    public const string CertificateAccept =
        "image/jpeg,image/png,image/webp,image/gif,image/heif,image/heic,.jpg,.jpeg,.png,.webp,.gif,.heif,.heic";

    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public IReadOnlyList<string> FileNames { get; set; } = Array.Empty<string>();
    [Parameter] public string Accept { get; set; } = CertificateAccept;
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowSummary { get; set; } = true;
    [Parameter] public string? Label { get; set; }

    private string SummaryText => FileNames.Count switch
    {
        0 => "No file chosen",
        1 => FileNames[0],
        _ => $"{FileNames.Count} files: {string.Join(", ", FileNames)}",
    };

    private string ButtonText => Label ?? (Multiple ? "Choose files" : "Choose file");
}
