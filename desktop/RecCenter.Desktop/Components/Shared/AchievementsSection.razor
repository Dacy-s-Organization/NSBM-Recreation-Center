@inject AchievementsService AchievementsData
@inject AuthService Auth
@inject DesktopBridge Bridge
@implements IDisposable

<div class="space-y-6">
    <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-[200px] flex-1 max-w-md">
            <label for="achievement-search" class="@Ui.Label">Search achievements</label>
            <input id="achievement-search" class="@Ui.Input" placeholder="@($"{NameHeader}, type, house, winner, notes, reference…")"
                   @bind="_search" @bind:event="oninput" @bind:after="ScheduleApply" />
        </div>
        <div>
            <label for="ach-year-filter" class="@Ui.Label">Year</label>
            <select id="ach-year-filter" class="@Ui.Select" value="@SelectedYear" @onchange="OnYearChanged">
                @foreach (var y in Years)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        @if (HasCategories)
        {
            <div>
                <label for="ach-category-filter" class="@Ui.Label">Category</label>
                <select id="ach-category-filter" class="@Ui.Select" @bind="_category" @bind:after="OnCategoryChanged">
                    <option value="">All categories</option>
                    <option value="other">Other sports</option>
                    <option value="athletics">Athletics</option>
                </select>
            </div>
        }
        <div>
            <label for="ach-sport-filter" class="@Ui.Label">@NameHeader</label>
            <select id="ach-sport-filter" class="@Ui.Select" @bind="_sport" @bind:after="ScheduleApply">
                <option value="">@AllSportsLabel</option>
                @foreach (var name in SportFilterOptions)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        <Button Variant="secondary" Disabled="@(Filtered.Count == 0)" OnClick="ExportFiltered">Export</Button>
        @if (Auth.CanEdit)
        {
            <Button Class="ml-auto" OnClick="OpenAdd">Add achievement</Button>
        }
    </div>

    @if (_error is not null && !_showForm && _editing is null)
    {
        <p class="text-sm text-red-600 dark:text-red-300">@_error</p>
    }

    @if (Auth.CanEdit && _showForm)
    {
        <Modal TrapKeyboard="true" CloseOnBackdrop="@(!_pending)" OnClose="CloseForm" PanelClass="max-h-[90vh] w-full max-w-3xl overflow-y-auto p-6">
            <div class="flex items-start justify-between gap-4">
                <h3 class="font-medium text-zinc-900 dark:text-white">New achievement</h3>
                <Button Variant="ghost" OnClick="CloseForm" Disabled="_pending">Close</Button>
            </div>
            <div class="mt-4">
                <AchievementFormFields @key="_addFormKey" Houses="Houses" Tracks="Tracks" TeamCards="TeamCards" HasCategories="HasCategories"
                                       DefaultCategory="@(ActiveCategory.Length > 0 ? ActiveCategory : "other")" DefaultYear="SelectedYear"
                                       Pending="_pending" Error="@_error" OnSubmit="HandleAdd" SubmitLabel="Save achievement" OnCancel="CloseForm" />
            </div>
        </Modal>
    }

    @if (Auth.CanEdit && _editing is not null)
    {
        <Modal TrapKeyboard="true" CloseOnBackdrop="@(!_pending)" OnClose="CloseForm" PanelClass="max-h-[90vh] w-full max-w-3xl overflow-y-auto p-6">
            <div class="flex items-start justify-between gap-4">
                <h3 class="font-medium text-zinc-900 dark:text-white">Edit achievement — @LabelOf(_editing)</h3>
                <Button Variant="ghost" OnClick="CloseForm" Disabled="_pending">Close</Button>
            </div>
            <div class="mt-4">
                <AchievementFormFields @key="_editing.Id" Achievement="_editing" Houses="Houses" Tracks="Tracks" TeamCards="TeamCards" HasCategories="HasCategories" DefaultYear="SelectedYear"
                                       Pending="_pending" Error="@_error" OnSubmit="HandleUpdate" SubmitLabel="Save changes" OnCancel="CloseForm" />
            </div>
        </Modal>
    }

    <Card Class="relative overflow-hidden p-0" aria-busy="@(Busy || _filtering)">
        @if (Busy || _filtering)
        {
            <TableLoadingOverlay />
        }
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="@Ui.TableHead">
                    <tr>
                        <th class="@Ui.Th">@NameHeader</th>
                        <th class="@Ui.Th">Achievement</th>
                        <th class="@Ui.Th">Team</th>
                        <th class="@Ui.Th">Team card</th>
                        <th class="@Ui.Th">Winners</th>
                        <th class="@Ui.Th">Notes</th>
                        <th class="@Ui.Th">Reference no</th>
                        <th class="@Ui.Th">Certificates</th>
                        @if (Auth.CanEdit)
                        {
                        <th class="@Ui.Th">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="@(Auth.CanEdit ? 9 : 8)" class="px-4 py-8 text-center text-zinc-500 dark:text-zinc-400">No achievements for @SelectedYear.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Filtered)
                        {
                            <tr @key="a.Id" class="border-b border-zinc-100 last:border-0 dark:border-white/10">
                                    <td class="px-4 py-3 font-medium text-zinc-900 dark:text-zinc-100">@LabelOf(a)</td>
                                    <td class="px-4 py-3">@a.AchievementType</td>
                                    <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300">@(string.IsNullOrEmpty(a.TeamName) ? "—" : a.TeamName)</td>
                                    <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300">
                                        @if (!string.IsNullOrEmpty(a.TeamCards?.EventName) && !string.IsNullOrEmpty(a.TeamCardId))
                                        {
                                            <a class="text-emerald-700 underline dark:text-emerald-300" href="@($"/team-cards?card={a.TeamCardId}")">@a.TeamCards.EventName</a>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300">@FormatWinners(a)</td>
                                    <td class="px-4 py-3 text-zinc-500 dark:text-zinc-400">@(string.IsNullOrEmpty(a.Notes) ? "—" : a.Notes)</td>
                                    <td class="px-4 py-3 font-mono">@(a.CertificateReferences?.ReferenceNo ?? "—")</td>
                                    <td class="px-4 py-3"><CertificateLinks Items="CertificateItems(a)" /></td>
                                    @if (Auth.CanEdit)
                                    {
                                    <td class="px-4 py-3">
                                        <div class="flex flex-wrap gap-2">
                                            <Button Variant="ghost" OnClick="() => StartEdit(a)">Edit</Button>
                                            <Button Variant="danger" OnClick="() => HandleDelete(a.Id, LabelOf(a))" Disabled="_pending">Delete</Button>
                                        </div>
                                    </td>
                                    }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="border-t border-zinc-100 px-4 py-2 text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400">
            @Filtered.Count achievement(s) for @SelectedYear@(_appliedCategory.Length > 0 && HasCategories ? (_appliedCategory == "athletics" ? " · athletics" : " · other sports") : "")@(_appliedSport.Length > 0 ? $" · {_appliedSport}" : "")@(_appliedSearch.Trim().Length > 0 ? " · matching search" : "")
        </p>
    </Card>
    <StudentDetailModal StudentId="@_openStudentId" OnClose="CloseStudent" />
    @if (_askOpen)
    {
        <ConfirmDialog Title="@_askTitle" Description="@_askBody" Pending="_pending" OnConfirm="() => Answer(true)" OnClose="() => Answer(false)" />
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SportsAchievement> Achievements { get; set; } = Array.Empty<SportsAchievement>();
    [Parameter] public IReadOnlyList<House> Houses { get; set; } = Array.Empty<House>();
    [Parameter] public IReadOnlyList<int> Years { get; set; } = Array.Empty<int>();
    [Parameter] public int SelectedYear { get; set; }
    [Parameter] public EventCallback<int> OnYearSelected { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public AchievementSection Section { get; set; }
    [Parameter] public bool HasCategories { get; set; }
    [Parameter] public IReadOnlyList<TeamCardOption> TeamCards { get; set; } = Array.Empty<TeamCardOption>();
    [Parameter] public IReadOnlyList<SportTrack> Tracks { get; set; } = Array.Empty<SportTrack>();
    [Parameter] public IReadOnlyList<Sport> Sports { get; set; } = Array.Empty<Sport>();
    [Parameter] public bool Busy { get; set; }

    private bool _askOpen;
    private string _askTitle = "";
    private string _askBody = "";
    private TaskCompletionSource<bool>? _answer;

    private static string LabelOf(SportsAchievement achievement) =>
        achievement.Category == "athletics"
            ? achievement.SportTracks?.Name ?? achievement.Sport
            : achievement.Sport;

    private Task<bool> AskAsync(string title, string body)
    {
        _askTitle = title;
        _askBody = body;
        _askOpen = true;
        _answer = new TaskCompletionSource<bool>();
        _ = InvokeAsync(StateHasChanged);
        return _answer.Task;
    }

    private void Answer(bool yes)
    {
        _askOpen = false;
        _answer?.TrySetResult(yes);
    }

    private bool _showForm;
    private int _addFormKey;
    private SportsAchievement? _editing;
    private string? _error;
    private bool _pending;
    private string _search = "";
    private string _category = "";
    private string _sport = "";
    private string _appliedSearch = "";
    private string _appliedCategory = "";
    private string _appliedSport = "";
    private bool _filtering;
    private CancellationTokenSource? _filterCts;
    private string? _openStudentId;

    private void OpenStudent(string? studentId) => _openStudentId = studentId;

    private void CloseStudent() => _openStudentId = null;

    private static string CategoryOf(SportsAchievement achievement) =>
        achievement.Category == "athletics" ? "athletics" : "other";

    private string ActiveCategory => HasCategories ? _category : "other";

    private string NameHeader => ActiveCategory switch
    {
        "athletics" => "Event",
        "" => "Sport / Event",
        _ => "Sport",
    };

    private string AllSportsLabel => ActiveCategory switch
    {
        "athletics" => "All events",
        "" => "All sports and events",
        _ => "All sports",
    };

    private IEnumerable<string> SportFilterOptions
    {
        get
        {
            var active = ActiveCategory;
            var trackNames = Tracks.Select(t => t.Name);
            var sportNames = Sports.Select(s => s.Name);
            var names = active switch
            {
                "athletics" => trackNames,
                "" => sportNames.Concat(trackNames),
                _ => sportNames,
            };
            var inCategory = active.Length > 0 ? Achievements.Where(a => CategoryOf(a) == active) : Achievements;
            return names.Concat(inCategory.Select(LabelOf))
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase);
        }
    }

    private List<SportsAchievement> Filtered
    {
        get
        {
            IEnumerable<SportsAchievement> list = Achievements;
            var category = HasCategories ? _appliedCategory : "other";
            if (category.Length > 0) list = list.Where(a => CategoryOf(a) == category);
            if (_appliedSport.Length > 0) list = list.Where(a => string.Equals(LabelOf(a), _appliedSport, StringComparison.OrdinalIgnoreCase));
            var q = _appliedSearch.Trim();
            if (q.Length == 0) return list.ToList();
            return list.Where(a =>
            {
                var winners = a.SportsAchievementWinners ?? new List<AchievementWinner>();
                var winnerText = string.Join(" ", winners.Select(w => $"{w.Students?.FullName} {w.Students?.StudentId}"));
                return Contains(LabelOf(a), q) || Contains(a.AchievementType, q) || Contains(a.TeamName, q)
                    || Contains(a.TeamCards?.EventName, q)
                    || Contains(winnerText, q) || Contains(a.Notes, q) || Contains(a.CertificateReferences?.ReferenceNo, q);
            }).ToList();
        }
    }

    private void OnCategoryChanged()
    {
        _sport = "";
        ScheduleApply();
    }

    private void ScheduleApply()
    {
        _filterCts?.Cancel();
        _filterCts?.Dispose();
        var cts = new CancellationTokenSource();
        _filterCts = cts;
        _filtering = true;
        _ = ApplyAfterDelayAsync(cts.Token);
    }

    private async Task ApplyAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _appliedSearch = _search;
        _appliedCategory = _category;
        _appliedSport = _sport;
        _filtering = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _filterCts?.Cancel();
        _filterCts?.Dispose();
    }

    private static bool Contains(string? value, string query) =>
        !string.IsNullOrEmpty(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<CertificateLinks.CertificateLinkItem> CertificateItems(SportsAchievement achievement) =>
        (achievement.CertificateReferences?.IssuedCertificates ?? new List<IssuedCertificateMeta>())
            .Select(file => new CertificateLinks.CertificateLinkItem { Id = file.Id, FileName = file.FileName })
            .ToList();

    private Task OnYearChanged(ChangeEventArgs e)
    {
        var year = Formatting.ParseIntLoose(e.Value?.ToString());
        return year is null ? Task.CompletedTask : OnYearSelected.InvokeAsync(year.Value);
    }

    private RenderFragment FormatWinners(SportsAchievement a) => __builder =>
    {
        var winners = a.SportsAchievementWinners;
        if (winners is null || winners.Count == 0)
        {
            <span>—</span>
            return;
        }
        var first = true;
        foreach (var w in winners)
        {
            if (!first) { <span>, </span> }
            first = false;
            var name = w.Students?.FullName;
            var studentId = w.Students?.StudentId;
            var place = string.IsNullOrEmpty(w.Place) ? "" : $"{w.Place} ";
            var label = !string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(studentId)
                ? $"{place}{name} ({studentId})"
                : $"{place}{name ?? studentId ?? "?"}";
            if (string.IsNullOrEmpty(studentId))
            {
                <span>@label</span>
            }
            else
            {
                <button type="button" class="text-sky-700 underline-offset-2 hover:underline dark:text-sky-300" @onclick="() => OpenStudent(studentId)">@label</button>
            }
        }
    };

    private void OpenAdd()
    {
        _showForm = true;
        _addFormKey++;
        _editing = null;
        _error = null;
    }

    private void StartEdit(SportsAchievement a)
    {
        _editing = a;
        _showForm = false;
        _error = null;
    }

    private void CloseForm()
    {
        if (_pending) return;
        _showForm = false;
        _editing = null;
        _error = null;
    }

    private async Task HandleAdd(AchievementForm form)
    {
        _error = null;
        _pending = true;
        var result = await AchievementsData.AddAsync(Section, form);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _showForm = false;
        _error = null;
        await FollowSavedYear(form);
    }

    private async Task HandleUpdate(AchievementForm form)
    {
        _error = null;
        _pending = true;
        var result = await AchievementsData.UpdateAsync(Section, form);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _editing = null;
        _error = null;
        await FollowSavedYear(form);
    }

    private async Task FollowSavedYear(AchievementForm form)
    {
        var savedYear = Formatting.ParseIntLoose(form.MeetYear);
        if (savedYear is not null && savedYear.Value != SelectedYear)
            await OnYearSelected.InvokeAsync(savedYear.Value);
        else
            await OnChanged.InvokeAsync();
    }

    private static string WinnersText(SportsAchievement achievement)
    {
        var winners = achievement.SportsAchievementWinners;
        if (winners is null || winners.Count == 0) return "";
        return string.Join(", ", winners.Select(winner =>
        {
            var name = winner.Students?.FullName;
            var studentId = winner.Students?.StudentId;
            var place = string.IsNullOrEmpty(winner.Place) ? "" : $"{winner.Place} ";
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(studentId))
                return $"{place}{name} ({studentId})";
            return $"{place}{name ?? studentId ?? ""}".Trim();
        }).Where(text => text.Length > 0));
    }

    private void ExportFiltered()
    {
        var csv = CsvText.Build(
            new[] { "Year", NameHeader, "Achievement", "Team", "Team card", "Winners", "Notes", "Reference no" },
            Filtered.Select(achievement => (IEnumerable<string?>)new[]
            {
                achievement.MeetYear.ToString(CultureInfo.InvariantCulture),
                CsvText.Blank(LabelOf(achievement)),
                CsvText.Blank(achievement.AchievementType),
                CsvText.Blank(achievement.TeamName),
                CsvText.Blank(achievement.TeamCards?.EventName),
                WinnersText(achievement),
                CsvText.Blank(achievement.Notes),
                CsvText.Blank(achievement.CertificateReferences?.ReferenceNo),
            }));
        var categorySlug = HasCategories && ActiveCategory.Length > 0 ? $"-{ActiveCategory}" : "";
        var allLabel = ActiveCategory == "athletics" ? "all-events" : "all-sports";
        Bridge.SaveTextFile(
            $"sports-achievements-{AchievementSections.Get(Section).Key}-{SelectedYear}{categorySlug}-{CsvText.FileSlug(_sport.Length > 0 ? _sport : allLabel)}.csv",
            csv);
    }

    private async Task HandleDelete(string id, string sport)
    {
        if (!await AskAsync($"Delete the achievement for {sport}?", "This removes the achievement and its certificate reference.")) return;
        _error = null;
        _pending = true;
        var result = await AchievementsData.DeleteAsync(Section, id);
        _pending = false;
        if (!result.Success) _error = result.Error;
        else
        {
            if (_editing?.Id == id) _editing = null;
            await OnChanged.InvokeAsync();
        }
    }
}
