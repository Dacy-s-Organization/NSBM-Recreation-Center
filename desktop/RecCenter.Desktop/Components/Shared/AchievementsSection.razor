@inject AchievementsService AchievementsData
@inject IJSRuntime JS
@inject AuthService Auth

<div class="space-y-6">
    <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-[200px] flex-1 max-w-md">
            <label for="achievement-search" class="@Ui.Label">Search achievements</label>
            <input id="achievement-search" class="@Ui.Input" placeholder="Sport, type, house, winner, notes, reference…" @bind="_search" @bind:event="oninput" />
        </div>
        <div>
            <label for="ach-year-filter" class="@Ui.Label">Year</label>
            <select id="ach-year-filter" class="@Ui.Select" value="@SelectedYear" @onchange="OnYearChanged">
                @foreach (var y in Years)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        @if (Auth.CanEdit)
        {
            <Button Class="ml-auto" OnClick="ToggleAddForm">@(_showForm ? "Cancel" : "Add achievement")</Button>
        }
    </div>

    @if (_error is not null && !_showForm && _editingId is null)
    {
        <p class="text-sm text-red-600 dark:text-red-300">@_error</p>
    }

    @if (Auth.CanEdit && _showForm)
    {
        <Card>
            <h3 class="font-medium text-zinc-900 dark:text-zinc-100">New sports achievement</h3>
            <div class="mt-4">
                <AchievementFormFields @key="_addFormKey" Houses="Houses" DefaultYear="SelectedYear" Pending="_pending" Error="_error"
                                       OnSubmit="HandleAdd" SubmitLabel="Save achievement" />
            </div>
        </Card>
    }

    <Card Class="overflow-hidden p-0">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="@Ui.TableHead">
                    <tr>
                        <th class="@Ui.Th">Sport</th>
                        <th class="@Ui.Th">Achievement</th>
                        <th class="@Ui.Th">Team</th>
                        <th class="@Ui.Th">Winners</th>
                        <th class="@Ui.Th">Notes</th>
                        <th class="@Ui.Th">Reference no</th>
                        <th class="@Ui.Th">Certificates</th>
                        @if (Auth.CanEdit)
                        {
                        <th class="@Ui.Th">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Filtered.Count == 0)
                    {
                        <tr>
                            <td colspan="@(Auth.CanEdit ? 8 : 7)" class="px-4 py-8 text-center text-zinc-500 dark:text-zinc-400">No achievements for @SelectedYear.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Filtered)
                        {
                            <tr @key="a.Id" class="border-b border-zinc-100 last:border-0 dark:border-white/10">
                                @if (Auth.CanEdit && _editingId == a.Id)
                                {
                                    <td colspan="8" class="px-4 py-3">
                                        <p class="mb-3 font-medium text-zinc-900 dark:text-zinc-100">Edit achievement</p>
                                        <AchievementFormFields @key="a.Id" Achievement="a" Houses="Houses" DefaultYear="SelectedYear"
                                                               Pending="_pending" Error="_error" OnSubmit="HandleUpdate"
                                                               SubmitLabel="Save changes" OnCancel="CancelEdit" />
                                    </td>
                                }
                                else
                                {
                                    <td class="px-4 py-3 font-medium text-zinc-900 dark:text-zinc-100">@a.Sport</td>
                                    <td class="px-4 py-3">@a.AchievementType</td>
                                    <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300">@(string.IsNullOrEmpty(a.TeamName) ? "—" : a.TeamName)</td>
                                    <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300">@FormatWinners(a)</td>
                                    <td class="px-4 py-3 text-zinc-500 dark:text-zinc-400">@(string.IsNullOrEmpty(a.Notes) ? "—" : a.Notes)</td>
                                    <td class="px-4 py-3 font-mono">@(a.CertificateReferences?.ReferenceNo ?? "—")</td>
                                    <td class="px-4 py-3"><CertificateLinks Items="CertificateItems(a)" /></td>
                                    @if (Auth.CanEdit)
                                    {
                                    <td class="px-4 py-3">
                                        <div class="flex flex-wrap gap-2">
                                            <Button Variant="ghost" OnClick="() => StartEdit(a)">Edit</Button>
                                            <Button Variant="danger" OnClick="() => HandleDelete(a.Id, a.Sport)" Disabled="_pending">Delete</Button>
                                        </div>
                                    </td>
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="border-t border-zinc-100 px-4 py-2 text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400">
            @Filtered.Count achievement(s) for @SelectedYear@(_search.Trim().Length > 0 ? " · matching search" : "")
        </p>
    </Card>
    <StudentDetailModal StudentId="_openStudentId" OnClose="() => _openStudentId = null" />
</div>

@code {
    [Parameter] public IReadOnlyList<SportsAchievement> Achievements { get; set; } = Array.Empty<SportsAchievement>();
    [Parameter] public IReadOnlyList<House> Houses { get; set; } = Array.Empty<House>();
    [Parameter] public IReadOnlyList<int> Years { get; set; } = Array.Empty<int>();
    [Parameter] public int SelectedYear { get; set; }
    [Parameter] public EventCallback<int> OnYearSelected { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _showForm;
    private int _addFormKey;
    private string? _editingId;
    private string? _error;
    private bool _pending;
    private string _search = "";
    private string? _openStudentId;

    private List<SportsAchievement> Filtered
    {
        get
        {
            var q = _search.Trim();
            if (q.Length == 0) return Achievements.ToList();
            return Achievements.Where(a =>
            {
                var winners = a.SportsAchievementWinners ?? new List<AchievementWinner>();
                var winnerText = string.Join(" ", winners.Select(w => $"{w.Students?.FullName} {w.Students?.StudentId}"));
                return Contains(a.Sport, q) || Contains(a.AchievementType, q) || Contains(a.TeamName, q)
                    || Contains(winnerText, q) || Contains(a.Notes, q) || Contains(a.CertificateReferences?.ReferenceNo, q);
            }).ToList();
        }
    }

    private static bool Contains(string? value, string query) =>
        !string.IsNullOrEmpty(value) && value.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<CertificateLinks.CertificateLinkItem> CertificateItems(SportsAchievement achievement) =>
        (achievement.CertificateReferences?.IssuedCertificates ?? new List<IssuedCertificateMeta>())
            .Select(file => new CertificateLinks.CertificateLinkItem { Id = file.Id, FileName = file.FileName })
            .ToList();

    private Task OnYearChanged(ChangeEventArgs e)
    {
        var year = Formatting.ParseIntLoose(e.Value?.ToString());
        return year is null ? Task.CompletedTask : OnYearSelected.InvokeAsync(year.Value);
    }

    private RenderFragment FormatWinners(SportsAchievement a) => __builder =>
    {
        var winners = a.SportsAchievementWinners;
        if (winners is null || winners.Count == 0)
        {
            <span>—</span>
            return;
        }
        var first = true;
        foreach (var w in winners)
        {
            if (!first) { <span>, </span> }
            first = false;
            var name = w.Students?.FullName;
            var studentId = w.Students?.StudentId;
            var place = string.IsNullOrEmpty(w.Place) ? "" : $"{w.Place} ";
            var label = !string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(studentId)
                ? $"{place}{name} ({studentId})"
                : $"{place}{name ?? studentId ?? "?"}";
            if (string.IsNullOrEmpty(studentId))
            {
                <span>@label</span>
            }
            else
            {
                <button type="button" class="text-sky-700 underline-offset-2 hover:underline dark:text-sky-300" @onclick="() => _openStudentId = studentId">@label</button>
            }
        }
    };

    private void ToggleAddForm()
    {
        _showForm = !_showForm;
        if (_showForm) _addFormKey++;
        _editingId = null;
        _error = null;
    }

    private void StartEdit(SportsAchievement a)
    {
        _editingId = a.Id;
        _showForm = false;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _error = null;
    }

    private async Task HandleAdd(AchievementForm form)
    {
        _error = null;
        _pending = true;
        var result = await AchievementsData.AddAsync(form);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _showForm = false;
        _error = null;
        await OnChanged.InvokeAsync();
    }

    private async Task HandleUpdate(AchievementForm form)
    {
        _error = null;
        _pending = true;
        var result = await AchievementsData.UpdateAsync(form);
        _pending = false;
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        _editingId = null;
        _error = null;
        await OnChanged.InvokeAsync();
    }

    private async Task HandleDelete(string id, string sport)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete sports achievement for {sport}?")) return;
        _error = null;
        _pending = true;
        var result = await AchievementsData.DeleteAsync(id);
        _pending = false;
        if (!result.Success) _error = result.Error;
        else
        {
            if (_editingId == id) _editingId = null;
            await OnChanged.InvokeAsync();
        }
    }
}
