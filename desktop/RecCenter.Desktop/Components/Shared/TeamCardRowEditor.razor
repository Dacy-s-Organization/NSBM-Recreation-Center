<div class="space-y-2">
    @if (Rows.Count == 0)
    {
        <p class="text-sm text-zinc-500">No athletes were found. Add a row before saving.</p>
    }
    @for (var i = 0; i < Rows.Count; i++)
    {
        var index = i;
        <div class="grid gap-2 sm:grid-cols-[8rem_1fr_6rem_auto]">
            <input class="@Ui.Input" aria-label="Student ID" @bind="Rows[index].StudentId" />
            <input class="@Ui.Input" aria-label="Name" @bind="Rows[index].FullName" />
            <input class="@Ui.Input" aria-label="Jersey No" @bind="Rows[index].JerseyNo" />
            <Button Variant="ghost" OnClick="() => Remove(index)">Remove</Button>
        </div>
    }
    <Button Variant="secondary" OnClick="Add">Add row</Button>
</div>

@code {
    [Parameter, EditorRequired] public List<TeamCardsService.TeamCardDraftRow> Rows { get; set; } = new();
    [Parameter] public EventCallback RowsChanged { get; set; }

    private async Task Remove(int index)
    {
        if (index >= 0 && index < Rows.Count) Rows.RemoveAt(index);
        await RowsChanged.InvokeAsync(Rows);
    }

    private async Task Add()
    {
        Rows.Add(new TeamCardsService.TeamCardDraftRow());
        await RowsChanged.InvokeAsync(Rows);
    }
}
