@inject AuthService Auth
@inject SupabaseOptions Options
@inject IJSRuntime JS
@inject WindowThemeBridge WindowTheme

@if (!Options.IsConfigured)
{
    <div class="flex min-h-full flex-1 items-center justify-center p-6">
        <div class="w-full max-w-lg rounded-2xl border border-red-200 bg-white p-6 shadow-sm dark:border-red-900/50 dark:bg-[var(--app-surface)]">
            <h1 class="text-lg font-semibold text-zinc-900 dark:text-white">Supabase is not configured</h1>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
                Rebuild the app with the Supabase URL and publishable key embedded. A file next to the exe is used only in a Debug build.
            </p>
        </div>
    </div>
}
else if (!_ready)
{
    <div class="flex min-h-full flex-1 items-center justify-center">
        <img src="logo.png" alt="NSBM Green University" class="h-12 w-auto animate-pulse object-contain" />
    </div>
}
else
{
    <Router AppAssembly="typeof(Main).Assembly">
        <Found Context="routeData">
            <ErrorBoundary @ref="_errors">
                <ChildContent>
                    <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="mx-auto max-w-[1600px] px-4 py-8 sm:px-6">
                        @if (ConnectionState.IsConnectionFailure(exception))
                        {
                            <OfflineNotice Message="@ConnectionState.SessionMessage" OnRetry="Recover" />
                        }
                        else
                        {
                            <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-white/10 dark:bg-[var(--app-surface)]">
                                <p class="text-sm text-zinc-700 dark:text-zinc-300">This page could not be loaded.</p>
                                <Button Variant="secondary" Class="mt-4" OnClick="Recover">Retry</Button>
                            </div>
                        }
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <p class="text-zinc-600 dark:text-zinc-400">Page not found.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _ready;
    private ErrorBoundary? _errors;

    private void Recover() => _errors?.Recover();

    protected override async Task OnInitializedAsync()
    {
        if (Options.IsConfigured) await Auth.TryRestoreAsync();
        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        WindowTheme.Set(await JS.InvokeAsync<string>("recTheme.get") == "dark");
    }
}
