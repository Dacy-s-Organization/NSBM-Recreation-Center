@inherits LayoutComponentBase
@implements IDisposable
@using System.Net.NetworkInformation
@inject AuthService Auth
@inject ConnectionState Connection
@inject AppState State
@inject NavigationManager Nav

@if (Auth.IsSignedIn)
{
    <div class="min-h-full">
        <AppNav />
        <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-6">
            @if (Connection.Offline)
            {
                <OfflineNotice Message="@ConnectionState.SessionMessage" OnRetry="Retry" />
            }
            @Body
        </main>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.SessionChanged += OnSessionChanged;
        Connection.Changed += OnConnectionChanged;
        NetworkChange.NetworkAvailabilityChanged += OnNetworkAvailability;
        if (!NetworkInterface.GetIsNetworkAvailable()) Connection.ReportOffline();
        if (!Auth.IsSignedIn)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }
#if !DEBUG
        if (Auth.CanEdit && !Auth.HasStrongAssurance)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }
#endif
        if (Auth.HasStrongAssurance || !NetworkInterface.GetIsNetworkAvailable()) return;
        if (await Auth.VerifiedTotpFactorIdAsync() is not null)
            Nav.NavigateTo("/login", replace: true);
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (!Auth.IsSignedIn) Nav.NavigateTo("/login", replace: true);
            StateHasChanged();
        });
    }

    private void OnConnectionChanged() => _ = InvokeAsync(StateHasChanged);

    private async void OnNetworkAvailability(object? sender, NetworkAvailabilityEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            if (!e.IsAvailable) Connection.ReportOffline();
            else await State.RequestRefreshAsync();
            StateHasChanged();
        });
    }

    private Task Retry() => State.RequestRefreshAsync();

    public void Dispose()
    {
        Auth.SessionChanged -= OnSessionChanged;
        Connection.Changed -= OnConnectionChanged;
        NetworkChange.NetworkAvailabilityChanged -= OnNetworkAvailability;
    }
}
