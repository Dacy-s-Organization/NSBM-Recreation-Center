<Window x:Class="RecCenter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:RecCenter.Desktop"
        xmlns:components="clr-namespace:RecCenter.Desktop.Components"
        x:Name="Root"
        Title="NSBM Recreation Center"
        Icon="app.ico"
        Width="1440" Height="900"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5EC" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E4E4E7" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TitleTextBrush" Color="#14261A" />
        <SolidColorBrush x:Key="TitleButtonHoverBrush" Color="#0F000000" />
        <SolidColorBrush x:Key="TitleButtonPressedBrush" Color="#1F000000" />
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="ClosePressedBrush" Color="#B3261A" />

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TitleButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TitleButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ClosePressedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleContent" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="app.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="NSBM Recreation Center"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource TitleTextBrush}" />
            </StackPanel>

            <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="OnMaximizeRestore" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                        ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose" />
            </StackPanel>
        </Grid>

        <local:EmbeddedBlazorWebView x:Name="BlazorView" Grid.Row="1" HostPage="wwwroot\index.html">
            <local:EmbeddedBlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Main}" />
            </local:EmbeddedBlazorWebView.RootComponents>
        </local:EmbeddedBlazorWebView>
    </Grid>
</Window>
