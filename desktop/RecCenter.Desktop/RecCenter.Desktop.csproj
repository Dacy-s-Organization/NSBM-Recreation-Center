<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2's WPF composition control needs the Windows 10 SDK projection -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>RecCenter.Desktop</RootNamespace>
    <AssemblyName>NSBM Recreation Center</AssemblyName>
    <Product>NSBM Recreation Center</Product>
    <Company>NSBM Green University</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- wwwroot is served from embedded resources so the published exe is fully self-contained -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;package*.json</DefaultItemExcludes>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecCenter.Core\RecCenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <!-- Referenced directly only to locate blazor.webview.js, which ships as a static web asset -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.webview.js" Link="wwwroot\_framework\blazor.webview.js" />
    <Content Remove="appsettings*.json" />
    <None Remove="appsettings*.json" />
    <EmbeddedResource Include="appsettings.json" Condition="Exists('appsettings.json')" LogicalName="appsettings.json" />
    <None Remove="Styles\**" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
